# ─── Google Analytics & Tag Manager ───────────────────────────────────────────
# Replace with your actual GA4 measurement ID (format: G-XXXXXXXXXX)
VITE_GA4_ID=G-XXXXXXXXXX

# Replace with your actual GTM container ID (format: GTM-XXXXXXX)
VITE_GTM_ID=GTM-XXXXXXX

# ─── Web3Forms (Contact & Admission Forms) ────────────────────────────────────
# Get a free key at https://web3forms.com
# Forms will fall back to WhatsApp if this is not set
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here
